{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "BlobSeek": {
    "Storage": {
      "SasExpiryMinutes": 60,
      "Accounts": []
    },
    "Indexing": {
      "BatchSize": 100,
      "MaxConcurrency": 4,
      "PollingIntervalSeconds": 300,
      "MaxBlobMegabytes": 50,
      "MaxTextCharacters": 50000,
      "DataDirectory": "/data",
      "LeaseMinutes": 30
    },
    "Search": {
      "IndexDirectory": "/data/lucene"
    }
  }
}
