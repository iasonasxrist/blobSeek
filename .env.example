# Copy to .env and fill in either ConnectionString or ServiceUri.
# Environment variables follow .NET's nested configuration convention.

BlobSeek__Storage__SasExpiryMinutes=60
BlobSeek__Storage__Accounts__0__Name=primary
BlobSeek__Storage__Accounts__0__ConnectionString=DefaultEndpointsProtocol=https;AccountName=example;AccountKey=replace-me;EndpointSuffix=core.windows.net
# BlobSeek__Storage__Accounts__0__ServiceUri=https://example.blob.core.windows.net
BlobSeek__Storage__Accounts__0__Containers__0=documents
# Add more containers with BlobSeek__Storage__Accounts__0__Containers__1=archive
# Add more accounts with BlobSeek__Storage__Accounts__1__Name=secondary

BlobSeek__Indexing__BatchSize=100
BlobSeek__Indexing__MaxConcurrency=4
BlobSeek__Indexing__PollingIntervalSeconds=300
BlobSeek__Indexing__MaxBlobMegabytes=50
BlobSeek__Indexing__MaxTextCharacters=50000
BlobSeek__Indexing__DataDirectory=/data
BlobSeek__Indexing__LeaseMinutes=30
BlobSeek__Search__IndexDirectory=/data/lucene
